#!/bin/sh

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Only call zfs-auto-snapshot if it's available
command -v zfs-auto-snapshot >/dev/null 2>&1 || exit 0

set -- zfs-auto-snapshot --quiet --syslog --changed --label=hourly --keep=24 //

LOCKFILE='/run/zfs-auto-snapshot.lock'
if command -v flock >/dev/null 2>&1; then
    set -- flock -n "$LOCKFILE" "$@"
elif command -v lockf >/dev/null 2>&1; then
    set -- lockf -t 0 "$LOCKFILE" "$@"
fi

exec "$@"
